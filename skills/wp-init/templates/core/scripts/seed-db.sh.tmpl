#!/usr/bin/env bash
# Seed a fresh WordPress install with {{PROJECT_NAME}} content.
# Idempotent — safe to re-run.
set -euo pipefail

cd "$(dirname "$0")/.."

if [ -f .env ]; then
  set -a; source .env; set +a
fi

COMPOSE="docker compose"
SITE_URL="${WORDPRESS_SITE_URL:-http://localhost:{{WP_PORT}}}"
REACH_URL="http://localhost:${WP_PORT:-{{WP_PORT}}}"

# Install WP-CLI inside the container if missing.
$COMPOSE exec -T wordpress bash -c '
  command -v wp >/dev/null 2>&1 || (
    curl -sS -o /usr/local/bin/wp https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar
    chmod +x /usr/local/bin/wp
  )
'

WP="$COMPOSE exec -T wordpress wp --allow-root --url=$REACH_URL"

# 1. Install WP core.
$WP core is-installed 2>/dev/null || $WP core install \
  --url="$REACH_URL" \
  --title="{{PROJECT_NAME}}" \
  --admin_user=admin --admin_password=admin --admin_email=admin@example.test \
  --skip-email

# 2. Activate theme.
$WP theme activate {{THEME_SLUG}}

# 3. Install + activate plugins.
PLUGINS=()
{{#if PLUGIN_CF7}}PLUGINS+=("contact-form-7")
{{/if}}{{#if PLUGIN_SUPER_CACHE}}PLUGINS+=("wp-super-cache")
{{/if}}{{#if PLUGIN_RANK_MATH}}PLUGINS+=("seo-by-rank-math")
{{/if}}{{#if PLUGIN_UPDRAFT}}PLUGINS+=("updraftplus")
{{/if}}{{#if PLUGIN_WORDFENCE}}PLUGINS+=("wordfence")
{{/if}}{{#if PLUGIN_BSR}}PLUGINS+=("better-search-replace")
{{/if}}# WP_INIT:PLUGINS

for slug in "${PLUGINS[@]}"; do
  $WP plugin is-installed "$slug" 2>/dev/null || $WP plugin install "$slug" || echo "  skip: $slug"
  $WP plugin activate "$slug" 2>/dev/null || true
done

{{#if PLUGIN_WORDFENCE}}# Wordfence is heavy locally — deactivate after install. Re-activate on staging/prod.
$WP plugin deactivate wordfence 2>/dev/null || true
{{/if}}# WP_INIT:CUSTOM_PLUGINS

# 4. Permalinks.
$WP rewrite structure '/%postname%/' >/dev/null
$WP rewrite flush --hard >/dev/null

# 5. Discourage search engines until site is public.
$WP option update blog_public 0 >/dev/null

# 6. Normalize site URL.
$WP option update home    "$REACH_URL" >/dev/null
$WP option update siteurl "$REACH_URL" >/dev/null

echo ""
echo "✓ Seeding complete."
echo "  Open: $REACH_URL/wp-admin/"
echo "  Login: admin / admin"
