<?php
/** Tiny inline-SVG icon helper. */
if (!defined('ABSPATH')) { exit; }

/**
 * Render an SVG icon.
 *
 * @param string $name   one of: arrow, check, cal, user, phone, mail, pin, star
 * @param int    $size   pixel size (square)
 * @param float  $stroke stroke width
 * @param string $color  css color (default currentColor)
 */
function {{PREFIX}}_icon(string $name, int $size = 18, float $stroke = 1.5, string $color = 'currentColor'): string {
    $paths = [
        'arrow' => '<path d="M5 12h14M13 5l7 7-7 7"/>',
        'check' => '<path d="m4 12 5 5L20 6"/>',
        'cal'   => '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
        'user'  => '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
        'phone' => '<path d="M5 4h4l2 5-3 2a11 11 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 6a2 2 0 0 1 2-2Z"/>',
        'mail'  => '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
        'pin'   => '<path d="M12 22s7-7 7-12a7 7 0 0 0-14 0c0 5 7 12 7 12Z"/><circle cx="12" cy="10" r="2.5"/>',
        'star'  => '<path d="m12 3 2.8 6 6.2.9-4.5 4.4 1 6.2L12 17.7 6.5 20.5l1-6.2L3 9.9l6.2-.9Z"/>',
    ];
    $path = $paths[$name] ?? '';
    if (!$path) { return ''; }
    return sprintf(
        '<svg xmlns="http://www.w3.org/2000/svg" width="%1$d" height="%1$d" viewBox="0 0 24 24" fill="none" stroke="%2$s" stroke-width="%3$s" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">%4$s</svg>',
        $size,
        esc_attr($color),
        esc_attr((string)$stroke),
        $path
    );
}
