# Docker Compose project + port configuration.
# Copy to .env and customise per developer. .env is gitignored.
COMPOSE_PROJECT_NAME=wp-{{PROJECT_SLUG}}

# Host-side ports — defaults chosen to avoid collisions with other local WP projects.
WP_PORT={{WP_PORT}}
PHPMYADMIN_PORT={{PHPMYADMIN_PORT}}
DB_PORT={{DB_PORT}}

# Database credentials (local only — production uses cyberfolks-managed DB).
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
MYSQL_PASSWORD=wppass
MYSQL_ROOT_PASSWORD=rootpass

# WP site URL — should match the /etc/hosts alias.
WORDPRESS_SITE_URL=http://{{HOSTNAME}}:{{WP_PORT}}
