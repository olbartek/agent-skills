# FTPS deployment configuration.
# Copy to .env.deploy and fill in real credentials. NEVER commit .env.deploy.

FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=

# Paths are RELATIVE TO THE FTP USER'S LOGIN HOME.
# {{#if FTP_PATH_SUBDOMAIN}}If your FTP account lands inside the project
# subdomain root, the defaults below work as-is.{{else}}If your FTP account
# is scoped higher (lands at the public_html root), the {{PROJECT_SLUG}}/
# prefix is included below.{{/if}}
FTP_REMOTE_THEME_PATH={{#if FTP_PATH_SUBDOMAIN}}wp-content/themes/{{THEME_SLUG}}{{else}}{{PROJECT_SLUG}}/wp-content/themes/{{THEME_SLUG}}{{/if}}
FTP_REMOTE_PLUGIN_PATH={{#if FTP_PATH_SUBDOMAIN}}wp-content/plugins{{else}}{{PROJECT_SLUG}}/wp-content/plugins{{/if}}

# Uploaded (overwritten): the custom theme + this list of custom plugins.
# Space-separated plugin directory names. Third-party plugins are NOT deployed
# via this script — install them through wp-admin on the server.
FTP_CUSTOM_PLUGINS=
# WP_INIT:CUSTOM_PLUGINS

# Set to 'yes' once you've installed a CA bundle for lftp; default 'no' on
# Homebrew (no CA bundle ships).
FTP_VERIFY_CERT=no
