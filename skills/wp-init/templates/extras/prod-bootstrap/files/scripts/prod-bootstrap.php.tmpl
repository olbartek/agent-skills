<?php
/**
 * ONE-SHOT PRODUCTION BOOTSTRAP — token-gated, self-destructing.
 * Generated by wp-init on {{TODAY_ISO}}.
 *
 * Upload to WP root, hit once via HTTPS with ?token=<secret>.
 * Installs configured plugins, sets pretty permalinks, deletes itself.
 *
 * If it fails, the file remains on disk for re-run. Every step is idempotent.
 */

$expected_token = '{{PROD_BOOTSTRAP_TOKEN}}';
if (!hash_equals($expected_token, (string)($_GET['token'] ?? ''))) {
    http_response_code(403);
    exit('forbidden');
}

@set_time_limit(600);
@ini_set('memory_limit', '256M');
@ini_set('display_errors', '1');
header('Content-Type: text/plain; charset=utf-8');

echo "▸ Starting prod bootstrap\n";

define('WP_USE_THEMES', false);
require_once __DIR__ . '/wp-load.php';
require_once ABSPATH . 'wp-admin/includes/admin.php';
require_once ABSPATH . 'wp-admin/includes/plugin-install.php';
require_once ABSPATH . 'wp-admin/includes/class-wp-upgrader.php';
require_once ABSPATH . 'wp-admin/includes/upgrade.php';

$plugins = [
    {{#if PLUGIN_CF7}}'contact-form-7'         => 'contact-form-7/wp-contact-form-7.php',
    {{/if}}{{#if PLUGIN_SUPER_CACHE}}'wp-super-cache'         => 'wp-super-cache/wp-cache.php',
    {{/if}}{{#if PLUGIN_RANK_MATH}}'seo-by-rank-math'       => 'seo-by-rank-math/rank-math.php',
    {{/if}}{{#if PLUGIN_UPDRAFT}}'updraftplus'            => 'updraftplus/updraftplus.php',
    {{/if}}{{#if PLUGIN_BSR}}'better-search-replace'  => 'better-search-replace/better-search-replace.php',
    {{/if}}{{#if MULTI_LANG}}'polylang'               => 'polylang/polylang.php',
    {{/if}}
];

echo "\n── Installing plugins ──\n";
foreach ($plugins as $slug => $plugin_file) {
    if (is_plugin_active($plugin_file)) { echo "  • $slug — already active\n"; continue; }
    $installed = file_exists(WP_PLUGIN_DIR . '/' . $plugin_file);
    if (!$installed) {
        $api = plugins_api('plugin_information', ['slug' => $slug, 'fields' => ['short_description' => false, 'sections' => false]]);
        if (is_wp_error($api)) { echo "  ! $slug — api: " . $api->get_error_message() . "\n"; continue; }
        $skin = new Automatic_Upgrader_Skin();
        $up   = new Plugin_Upgrader($skin);
        $res  = $up->install($api->download_link);
        if (is_wp_error($res) || $res !== true) { echo "  ! $slug — install failed\n"; continue; }
        echo "  + $slug — installed\n";
    }
    $act = activate_plugin($plugin_file);
    if (is_wp_error($act)) { echo "  ! $slug — activate: " . $act->get_error_message() . "\n"; continue; }
    echo "  ✓ $slug — activated\n";
}

{{#if CUSTOM_PLUGIN}}// Activate the bundled custom plugin (shipped via FTP earlier).
if (file_exists(WP_PLUGIN_DIR . '/{{PLUGIN_SLUG}}/{{PLUGIN_SLUG}}.php')) {
    if (!is_plugin_active('{{PLUGIN_SLUG}}/{{PLUGIN_SLUG}}.php')) {
        activate_plugin('{{PLUGIN_SLUG}}/{{PLUGIN_SLUG}}.php');
        echo "  ✓ {{PLUGIN_SLUG}} — activated\n";
    }
}
{{/if}}

update_option('blog_public', 0);
global $wp_rewrite;
$wp_rewrite->set_permalink_structure('/%postname%/');
$wp_rewrite->flush_rules(true);
echo "  ✓ Permalinks = /%postname%/, blog_public = 0\n";

echo "\n✓ Bootstrap complete.\n";
if (@unlink(__FILE__)) {
    echo "✓ Self-destructed: " . basename(__FILE__) . " removed.\n";
} else {
    echo "! Could not delete " . basename(__FILE__) . " — please remove it manually via FTP.\n";
}
