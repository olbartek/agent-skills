<?php
if (!defined('ABSPATH')) { exit; }

/** Return the URL for a given page slug in the current language. */
function {{PREFIX}}_page_url(string $slug): string {
    if (!function_exists('pll_get_post')) { return home_url('/' . $slug . '/'); }
    $page = get_page_by_path($slug);
    if (!$page) { return home_url('/' . $slug . '/'); }
    $translated = pll_get_post($page->ID);
    if (!$translated) { return home_url('/' . $slug . '/'); }
    return get_permalink($translated);
}

/** Return the current language slug, e.g. 'en'. */
function {{PREFIX}}_current_language(): string {
    if (!function_exists('pll_current_language')) { return ''; }
    $lang = pll_current_language('slug');
    return is_string($lang) ? $lang : '';
}
